 type emptyFS struct{}
 
 func (emptyFS) Open(_ string) (fs.File, error) { return nil, fs.ErrNotExist }
+
+func TestSQLiteUpgradePreservesNarinfoMetadata(t *testing.T) {
+	for _, boundary := range []string{"20260525175108", "20260605211804"} {
+		t.Run(boundary, func(t *testing.T) {
+			db, cleanup := openSQLiteTest(t)
+			t.Cleanup(cleanup)
+			db.SetMaxOpenConns(1)
+			sub := mustSubFS(t, "sqlite")
+			var previous []string
+
+			for _, name := range listMigrationFiles(t, sub) {
+				if name[:14] < boundary {
+					previous = append(previous, name)
+				}
+			}
+
+			applyMigrationsRaw(t, db, database.TypeSQLite, sub, previous)
+			seedDbmateSchemaMigrations(t, db, database.TypeSQLite, fileVersions(previous))
+			mustExec(t, db, "INSERT INTO narinfos (id, hash) VALUES (1, 'narinfo')")
+			mustExec(t, db, "INSERT INTO nar_files (id, hash, file_size) VALUES (1, 'nar', 100)")
+			mustExec(t, db, "INSERT INTO narinfo_references (narinfo_id, reference) VALUES (1, 'dependency')")
+			mustExec(t, db, "INSERT INTO narinfo_signatures (narinfo_id, signature) VALUES (1, 'signature')")
+			mustExec(t, db, "INSERT INTO narinfo_nar_files (narinfo_id, nar_file_id) VALUES (1, 1)")
+			mustExec(t, db, "INSERT INTO chunks (id, hash, size) VALUES (1, 'chunk', 100)")
+			mustExec(t, db, "INSERT INTO nar_file_chunks (nar_file_id, chunk_id, chunk_index) VALUES (1, 1, 0)")
+
+			opts := migrate.Options{DB: db, Dialect: database.TypeSQLite, MigrationsFS: sub}
+
+			for range 2 {
+				require.NoError(t, migrate.Up(t.Context(), opts))
+
+				for _, table := range []string{
+					"narinfos", "nar_files", "narinfo_references",
+					"narinfo_signatures", "narinfo_nar_files", "nar_file_chunks",
+				} {
+					var count int
+					require.NoError(t, db.QueryRow("SELECT count(*) FROM "+table).Scan(&count))
+					assert.Equal(t, 1, count, table)
+				}
+
+				var reference, signature string
+				require.NoError(t, db.QueryRow("SELECT reference FROM narinfo_references WHERE narinfo_id = 1").Scan(&reference))
+				require.NoError(t, db.QueryRow("SELECT signature FROM narinfo_signatures WHERE narinfo_id = 1").Scan(&signature))
+				assert.Equal(t, "dependency", reference)
+				assert.Equal(t, "signature", signature)
+			}
+		})
+	}
