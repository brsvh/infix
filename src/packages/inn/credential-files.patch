+sub resolvePassword {
+    my ($password) = @_;
+
+    return substr($password, 1) if $password =~ /^@@/;
+    return $password if $password !~ /^@(.*)$/;
+
+    my $path = $1;
+    if ($path =~ /^credential:(.+)$/) {
+        my $credential = $1;
+        my $directory = $ENV{'CREDENTIALS_DIRECTORY'};
+        die "CREDENTIALS_DIRECTORY is unset for credential $credential\n"
+          if !defined $directory || $directory eq '';
+        die "invalid credential name $credential\n"
+          if $credential =~ m{/} || $credential eq '.' || $credential eq '..';
+        $path = "$directory/$credential";
+    }
+
+    open(my $passwordFile, '<', $path)
+      || die "can't open password file $path: $!\n";
+    local $/;
+    my $resolved = <$passwordFile>;
+    close($passwordFile)
+      || die "can't close password file $path: $!\n";
+    $resolved =~ s/\r?\n\z//;
+    die "password file $path is empty\n" if $resolved eq '';
+    die "password file $path contains more than one line\n"
+      if $resolved =~ /[\r\n]/;
+    return $resolved;
+}
+
