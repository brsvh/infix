 sly-macrostep-autoloads.el | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/sly-macrostep-autoloads.el b/sly-macrostep-autoloads.el
index 46083bd..4583b2c 100644
--- a/sly-macrostep-autoloads.el
+++ b/sly-macrostep-autoloads.el
@@ -1,4 +1,4 @@
-;;; sly-macrostep-autoloads.el --- automatically extracted autoloads
+;;; sly-macrostep-autoloads.el --- automatically extracted autoloads -*- lexical-binding: t -*-
